# Postgres. Locally: postgres://<you>@localhost:5432/daaho_portfolio. On Vercel, the Neon integration
# sets this for you.
DATABASE_URL=postgres://127.0.0.1:5432/daaho_portfolio
# Long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Where the metadata pipeline lives, for `pnpm import:pipeline`.
PIPELINE_DIR=../daaho-metadata-pipeline

# File storage. Leave unset locally (files go to ./media). In production, a PRIVATE S3-compatible
# bucket — AWS S3 (or Cloudflare R2). See DEPLOY.md.
S3_BUCKET=
S3_ENDPOINT=          # AWS S3: leave empty.   R2: https://<account-id>.r2.cloudflarestorage.com
S3_REGION=us-east-2   # AWS S3: the bucket's region.   R2: auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The site's public address(es), comma-separated, the first being the default. Links in emails
# (invitations, password resets) only ever point to these. On Vercel:
#   SITE_URL=https://daaho.vercel.app,https://daaho.lib.miamioh.edu
# On the library server: SITE_URL=https://daaho.lib.miamioh.edu
SITE_URL=

# Email, for invitations and "Forgot password?". Leave unset to send nothing (the invitation panel
# then shows the link to send by hand). EMAIL_FROM must be on a domain verified with the provider.
EMAIL_FROM=
EMAIL_FROM_NAME=DAAHO
# Either Resend (while on Vercel)...
RESEND_API_KEY=
# ...or a mail server (the library server's relay). Used only when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
